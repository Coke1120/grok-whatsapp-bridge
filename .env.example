# Bind only on loopback unless fronted by Tailscale Serve / SSH tunnel / reverse proxy with auth.
# Bare metal leaves WHATSAPP_BIND_HOST unset (127.0.0.1). Docker compose sets
# 0.0.0.0 inside the container and publishes 127.0.0.1 on the host only.
# WHATSAPP_BIND_HOST=127.0.0.1
# Docker compose sets WHATSAPP_TRUSTED_HOSTS=bridge for the listener container.
# Leave this unset on bare metal. A public hostname does not belong here.
# WHATSAPP_TRUSTED_HOSTS=
WHATSAPP_BRIDGE_PORT=3100
WHATSAPP_MODE=bot
# Comma-separated E.164 digits (no +). Empty = nobody allowed inbound.
WHATSAPP_ALLOWED_USERS=
WHATSAPP_REPLY_PREFIX=
# Session lives here (do not commit)
WHATSAPP_SESSION_DIR=./session
# Optional fixed ack (no LLM). Empty = off.
WHATSAPP_PROGRAMMATIC_ACK=
# Optional webhook to wake an agent when allowlisted inbound arrives
WHATSAPP_WAKE_WEBHOOK_URL=
# Bearer token only (or full "Bearer …"). Quote if it contains spaces.
WHATSAPP_WAKE_WEBHOOK_AUTH=
WHATSAPP_POLL_MS=2000
# Listener files. Unset = beside listener.mjs. Docker points these at a volume.
# WHATSAPP_INBOX_PATH=
# WHATSAPP_LISTENER_STATE_PATH=
# WHATSAPP_UNREAD_FLAG_PATH=
# Socket reconnect backoff after 408/428 and other non-logout closes.
# First delay is the base; it doubles until the cap. Open resets the counter.
# WHATSAPP_RECONNECT_BASE_MS=3000
# WHATSAPP_RECONNECT_CAP_MS=60000

# --- Multi-account (optional) ---
# Leave WHATSAPP_ACCOUNTS unset and do not create accounts/*.env to keep the
# original single session (./session via ./start.sh and ./pair.sh).
#
# JSON object/array, or a path to a JSON file (accounts.json is gitignored):
#   WHATSAPP_ACCOUNTS=./accounts.json
# See accounts.example.json. WHATSAPP_DEFAULT_ACCOUNT overrides the file's "default".
#
# Or one gitignored env file per account: accounts/<name>.env
# (copy accounts/sales.env.example). *.env.example files are not accounts.
# WHATSAPP_ACCOUNTS_DIR=./accounts
