# Copy to accounts/sales.env (gitignored). Filename stem is the account name.
# WHATSAPP_ACCOUNT_NAME=sales
WHATSAPP_SESSION_DIR=./sessions/sales
WHATSAPP_MODE=bot
# Digits only, comma-separated. Omit the line to inherit WHATSAPP_ALLOWED_USERS.
WHATSAPP_ALLOWED_USERS=
# Optional per-account wake. Omit to inherit the process webhook.
# WHATSAPP_WAKE_WEBHOOK_URL=
# WHATSAPP_WAKE_WEBHOOK_AUTH=
# WHATSAPP_PROGRAMMATIC_ACK=
